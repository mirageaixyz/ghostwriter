{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "edit": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "draft": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}