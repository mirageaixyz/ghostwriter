{
  "name": "ghostwriter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "FORCE_COLOR=1 dotenv -- turbo run build",
    "start": "dotenv -- pnpm --filter server start",
    "produce": "dotenv -- pnpm --filter server produce",
    "draft": "dotenv -- pnpm --filter actor produce",
    "direct": "dotenv -- pnpm --filter video direct"
  },
  "devDependencies": {
    "prettier": "^2.7.1",
    "dotenv-cli": "latest",
    "turbo": "latest"
  },
  "packageManager": "pnpm@7.15.0",
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack"
      ]
    }
  }
}