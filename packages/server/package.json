{
  "name": "@ghostwriter/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "browser": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "produce": "node dist/render.js",
    "build": "tsup --format esm --treeshake --splitting"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/workerpool": "^6.4.5",
    "ts-node-dev": "^2.0.0",
    "tsup": "^7.2.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ghostwriter/actor": "workspace:*",
    "@hono/node-server": "^1.2.0",
    "@hono/trpc-server": "^0.1.0",
    "@hono/zod-validator": "^0.1.9",
    "@remotion/bundler": "4.0.50",
    "@remotion/renderer": "^4.0.50",
    "@remotion/tailwind": "4.0.50",
    "@trpc/server": "^10.40.0",
    "consola": "^3.1.0",
    "hono": "^3.8.1",
    "workerpool": "^6.5.1",
    "zod": "^3.21.4"
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "render": "src/render.ts"
    },
    "outDir": "dist",
    "clean": true,
    "treeshake": true,
    "splitting": true
  }
}