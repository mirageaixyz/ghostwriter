{
  "name": "@ghostwriter/actor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/export.ts",
  "browser": "src/export.ts",
  "files": [
    "out",
    "video.mp4"
  ],
  "scripts": {
    "produce": "tsx src/index.ts; cp -r out ../video/public",
    "save": "cp -r out ../video/public",
    "build": "tsup --format esm --treeshake --splitting"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.22",
    "@types/node": "^20.3.1",
    "dotenv-cli": "^7.3.0",
    "tsup": "^7.2.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "elevenlabs-node": "^1.2.0",
    "audioconcat": "^0.1.4",
    "consola": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "openai": "^4.11.1",
    "valibot": "^0.18.0"
  },
  "tsup": {
    "entry": {
      "index": "src/export.ts"
    },
    "outDir": "dist",
    "clean": true,
    "treeshake": true,
    "splitting": true
  }
}